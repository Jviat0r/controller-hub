{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Controller Hub",
  "version": "0.1.0",
  "identifier": "com.jviator.controllerhub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Controller Hub",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "drivers/*": "drivers/" },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installMode": "perMachine"
      }
    }
  }
}
